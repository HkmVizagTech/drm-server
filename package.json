{
  "name": "drm",
  "version": "1.0.0",
  "private": true,
  "description": "HKM Vizag Donor Relationship Manager - Express API and Next.js admin UI in one deployable service.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace client",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "start": "node server/dist/index.js",
    "db:schema": "node server/scripts/apply-schema.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
