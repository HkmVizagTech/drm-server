# Railway (and any host) sets NODE_ENV=production, which makes npm skip
# devDependencies. The client build NEEDS them: typescript, tailwindcss and
# @tailwindcss/postcss all live there, and `next build` fails without them.
# Committed here rather than set as a host variable so the setting travels with
# the repo and cannot be lost when a service is recreated.
include=dev
