# Copy to .env for local development. On Railway these are service variables,
# not a file.

# --- Required -------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/drm
JWT_SECRET=your-super-secret-key
PORT=4000
NODE_ENV=development

# --- Serving the admin UI -------------------------------------------------
# Unset, the server serves the built Next.js UI when NODE_ENV=production and
# not otherwise (in development you run `next dev` on its own port instead).
# Set explicitly to force it either way.
# SERVE_CLIENT=true

# --- hkmsite2.0-server (main site): donor sync, receipt proxy -------------
# HKMV_INTERNAL_SECRET must match INTERNAL_SECRET in that project's env.
HKMV_API_URL=https://your-hkmv-server-host
HKMV_INTERNAL_SECRET=shared-internal-secret

# --- annadan site: transaction feed, receipt proxy ------------------------
# ANNADAN_INTERNAL_SECRET must match DRM_SYNC_SECRET in the annadan project.
ANNADAN_API_URL=https://annadan.harekrishnavizag.org
ANNADAN_INTERNAL_SECRET=shared-annadan-secret

# --- Devotee leads: map and phone reminders --------------------------------
# Google Maps for the devotee map and "Find address on map". A browser key:
# restrict it to this site's address in Google Cloud, and enable "Maps
# JavaScript API" and "Geocoding API". Unset, the map is hidden and directions
# still open in Google Maps from the address.
# GOOGLE_MAPS_API_KEY=
# A Map ID from Google Cloud (Map Management). Unset uses Google's demo ID.
# GOOGLE_MAPS_MAP_ID=
#
# Web Push, so follow-up reminders reach a devotee's phone with DRM closed.
# Generate once with `npx web-push generate-vapid-keys` and never change them:
# a new pair silently orphans every phone that has turned reminders on.
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:admin@harekrishnavizag.org
#
# DCC, for receipts raised in the devotee portal. Those go straight to DCC from DRM (not through
# the HKM site), DRM draws the PDF, and no WhatsApp is sent. The office's and callers' receipts
# are unchanged and do not use these. Same names and values as the HKM site's settings.
# DCC_API_KEY=
# DCC_API_URL=https://vhkmsurabhi.com/api/socialmedia/addDonation
# DCC_ENROLLED_BY_REST=36
