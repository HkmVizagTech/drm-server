# Copy to .env for local development. On Railway these are service variables,
# not a file.

# --- Required -------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/drm
JWT_SECRET=your-super-secret-key
PORT=4000
NODE_ENV=development

# --- Serving the admin UI -------------------------------------------------
# Unset, the server serves the built Next.js UI when NODE_ENV=production and
# not otherwise (in development you run `next dev` on its own port instead).
# Set explicitly to force it either way.
# SERVE_CLIENT=true

# --- hkmsite2.0-server (main site): donor sync, receipt proxy -------------
# HKMV_INTERNAL_SECRET must match INTERNAL_SECRET in that project's env.
HKMV_API_URL=https://your-hkmv-server-host
HKMV_INTERNAL_SECRET=shared-internal-secret

# --- annadan site: transaction feed, receipt proxy ------------------------
# ANNADAN_INTERNAL_SECRET must match DRM_SYNC_SECRET in the annadan project.
ANNADAN_API_URL=https://annadan.harekrishnavizag.org
ANNADAN_INTERNAL_SECRET=shared-annadan-secret
